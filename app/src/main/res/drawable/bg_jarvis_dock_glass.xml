<?xml version="1.0" encoding="utf-8"?>
<!-- iPhone-style liquid glass dock: translucent gradient, crisp specular edge
     and a soft top highlight. The classic dock remains bg_jarvis_dock.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="?attr/themeDockGlassStart"
                android:endColor="?attr/themeDockGlassEnd" />
            <stroke
                android:width="1dp"
                android:color="?attr/themeDockBorder" />
        </shape>
    </item>

    <item
        android:left="20dp"
        android:top="2dp"
        android:right="20dp"
        android:bottom="54dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#59FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="31dp" />
            <stroke
                android:width="1dp"
                android:color="?attr/themeGlassSpecular" />
        </shape>
    </item>
</layer-list>
