<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlayAvatarRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/themeBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_jarvis_icon_square"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            app:tint="?attr/themeTextPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overlay Avatars"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pick the companion shown while Jarvis works"
                android:textColor="?attr/themeTextMuted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="?attr/themeCardBg"
        app:strokeColor="?attr/themeCardBorder"
        app:strokeWidth="1dp"
        app:cardCornerRadius="18dp">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchOverlayEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Show floating overlay"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="15sp" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="?attr/themeCardBg"
        app:strokeColor="?attr/themeCardBorder"
        app:strokeWidth="1dp"
        app:cardCornerRadius="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avatar visibility"
                android:textColor="?attr/themeTextPrimary"
                android:textStyle="bold"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/radioOverlayMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbOverlayWorking"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="While working"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbOverlayAlways"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Always on"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="12sp" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dock the avatar to an edge; dragging it will choose the nearest edge."
                android:textColor="?attr/themeTextMuted"
                android:textSize="11sp" />

            <Spinner
                android:id="@+id/spinnerOverlayEdge"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:entries="@array/overlay_edges"
                android:spinnerMode="dropdown" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="8dp"
        android:text="CHOOSE AN AVATAR"
        android:textColor="?attr/themeTextMuted"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="10dp"
        android:text="Tap an avatar to select it. Double-tap the floating avatar to see task progress."
        android:textColor="?attr/themeTextMuted"
        android:textSize="12sp" />

    <WebView
        android:id="@+id/avatarGallery"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:overScrollMode="never"
        android:scrollbars="none" />
</LinearLayout>
