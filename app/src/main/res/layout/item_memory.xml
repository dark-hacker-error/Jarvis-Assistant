<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_futuristic"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: Category & Date & Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMemoryCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_action"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="PREFERENCES"
            android:textColor="?attr/themeAccent"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tvMemoryDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Sep 12, 2026 • 15:30"
            android:textColor="?attr/themeTextMuted"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btnEditMemory"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_edit"
            app:tint="?attr/themeTextSecondary"
            android:contentDescription="Edit" />

        <ImageButton
            android:id="@+id/btnDeleteMemory"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            app:tint="@color/status_red"
            android:contentDescription="Delete" />
    </LinearLayout>

    <!-- Content / Fact Text -->
    <TextView
        android:id="@+id/tvMemoryFact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Favorite song is Believer."
        android:textColor="?attr/themeTextPrimary"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />

</LinearLayout>
